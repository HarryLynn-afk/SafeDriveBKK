# ── LLM (optional) ───────────────────────────────────────────────────────────
# Enables open-ended responses in the chatbot. Without this, the assistant
# falls back to scripted intents and ML-based cause detection.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Server key — used for traffic-aware routing and travel-time estimates.
# Without this, the app falls back to OSRM + estimated travel times.
GOOGLE_MAPS_SERVER_KEY=your_server_key_here

# Browser key — rendered into the trip planner page to display the map.
# Restrict this key to HTTP referrers in Google Cloud Console.
# Without this, the trip planner map will not render.
GOOGLE_MAPS_BROWSER_KEY=your_browser_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# Flask session secret. Auto-generated at startup if not set.
# Set a fixed value in production so sessions survive restarts.
SECRET_KEY=replace-with-a-random-secret

# ── Logging (optional) ────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# Path for rotating log file. Leave blank to log to console only.
# LOG_FILE=logs/app.log
